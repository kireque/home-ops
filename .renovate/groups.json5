{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 3,
    },
    {
      description: "Immich Group",
      groupName: "immich",
      matchDatasources: ["docker"],
      matchPackageNames: ["/immich-server/", "/immich-machine-learning/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      // Only ghcr.io/siderolabs/kubelet is tracked (talos/version.yaml and the
      // tuppr KubernetesUpgrade), so the group holds 2 updates; any higher
      // minimum keeps Kubernetes upgrades parked under "Group Size Not Met".
      minimumGroupSize: 2,
    },
    {
      description: "Rook-Ceph Group",
      groupName: "rook-ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // Unmatched matchDatasources on purpose: unites the mise pin (aqua),
      // the factory installer image, and the tuppr upgrade version, which
      // all resolve to packageName "siderolabs/talos" across three managers.
      // The talosFactory preset sets separateMinorPatch for the factory and
      // tuppr versions only, which routes their patches to renovate/patch-talos
      // while the mise pin stayed on renovate/talos; set it group-wide so every
      // member lands on the same branch.
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      separateMinorPatch: true,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      // Agent (cluster) and node (VPS docker-compose) must stay on matching versions.
      description: "Towonel Group",
      groupName: "towonel",
      matchDatasources: ["docker"],
      matchPackageNames: ["/towonel-agent/", "/towonel-node/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
  ],
}
