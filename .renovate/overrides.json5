{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      description: "Hold Rook-Ceph at v1.19.x",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      allowedVersions: "<1.20.0",
    },
    {
      // kaniop refuses a server newer than the Kanidm client it is built with and
      // never creates the StatefulSet; raise this together with the kaniop chart
      description: "Hold Kanidm at the 1.11.x client kaniop 0.21.0 supports",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/kanidm/server"],
      allowedVersions: "<1.12.0",
    },
    {
      description: "SearXNG tags are <date>-<commit>; compare on the date only",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/searxng/searxng"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$",
    },
    {
      // A month rollover parses as a minor, but SearXNG ships continuously and
      // publishes no release notes, so it carries no more risk than a daily bump
      description: "Label SearXNG month rollovers like the daily patch bumps",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/searxng/searxng"],
      matchUpdateTypes: ["minor"],
      labels: ["type/patch"],
    },
    {
      description: "Silo publishes ordered build-N tags and has no downgrade path; never automerge",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/silo-server/silo-server"],
      versioning: "regex:^build-(?<major>\\d+)$",
      automerge: false,
    },
    {
      description: "CNPG major upgrades need a new cnpg/pgNN component, never an in-place bump",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql", "ghcr.io/tensorchord/cloudnative-vectorchord"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
  ],
}
