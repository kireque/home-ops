{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "github>kireque/home-ops//.renovate/autoMerge.json5",
    "github>kireque/home-ops//.renovate/changelogs.json5",
    "github>kireque/home-ops//.renovate/customManagers.json5",
    "github>kireque/home-ops//.renovate/groups.json5",
    "github>kireque/home-ops//.renovate/labels.json5",
    "github>kireque/home-ops//.renovate/overrides.json5",
    "github>kireque/home-ops//.renovate/semanticCommits.json5",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0",
    ":automergeBranch",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    ":timezone(Europe/Amsterdam)",
  ],
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
  suppressNotifications: [
    "prEditedNotification",
    "prIgnoreNotification",
  ],
  ignorePaths: [
    "**/resources/**",
  ],
  // Resolves mirror.gcr.io references against Docker Hub so Renovate finds
  // tags/digests via the upstream registry (coredns, envoy-gateway,
  // cloudflare-tunnel all pull through this mirror).
  registryAliases: {
    "mirror.gcr.io": "docker.io",
  },
  flux: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    // Scoped to HelmRelease/values files (not every .yaml) so bare `image:`
    // lines elsewhere aren't double-extracted alongside the kubernetes
    // manager, which would inflate grouped-update counts (minimumGroupSize).
    managerFilePatterns: [
      "/(^|/)values\\.yaml(?:\\.j2)?$/",
      "/(^|/)helmrelease\\.yaml(?:\\.j2)?$/",
      "/(^|/)helm-release\\.yaml(?:\\.j2)?$/",
      "/(^|/)hr\\.yaml(?:\\.j2)?$/",
    ],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.yaml(?:\\.j2)?$/"],
  },
}
